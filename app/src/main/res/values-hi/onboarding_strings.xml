    <string name="onboarding_context_title">आप कहाँ जा रहे हैं?</string>
    <string name="onboarding_context_subtitle">उन चीज़ों के लिए एक संदर्भ चुनें जिन्हें आपको याद रखना है।</string>
    <string name="onboarding_context_field_label">गंतव्य या स्थान</string>
