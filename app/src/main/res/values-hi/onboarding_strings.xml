    <string name="onboarding_summary_title">रिमाइंडर बन गया!</string>
    <string name="onboarding_summary_subtitle">आप पूरी तरह तैयार हैं। आपके निकलने से पहले हम आपको याद दिलाएंगे।</string>
    <string name="onboarding_summary_status_active">सक्रिय</string>
    <string name="onboarding_summary_departure_header">प्रस्थान</string>
    <string name="onboarding_summary_reminder_header">रिमाइंडर</string>
    <string name="onboarding_summary_packing_header">पैकिंग चेकलिस्ट</string>
    <string name="onboarding_summary_items_count">%1$d आइटम</string>
    <string name="onboarding_action_done">हो गया ✓</string>

