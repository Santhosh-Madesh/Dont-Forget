    <string name="onboarding_packing_pack_all">✓ सब पैक करें</string>
    <string name="onboarding_packing_finish">ऊपर दिए गए आइटम टिक करें</string>

    <!-- Screen 7: Completion Victory -->
    <string name="onboarding_victory_brand_tag">• DON\'T FORGET V2</string>
    <string name="onboarding_victory_pill">✓ सक्रिय • 4 आइटम पैक • संकट टल गया</string>
    <string name="onboarding_victory_title">खुद को देखिए। पूरी तरह से तैयार।</string>
    <string name="onboarding_victory_body">बधाई हो! आपने अभी-अभी एक रिमाइंडर सेट किया है, और हमने यह सुनिश्चित किया कि आपकी सूची का हर एक आइटम वास्तव में पैक है। अपनी सभी चीज़ों के साथ घर से निकलना एक संभव सपना है।</string>
    <string name="onboarding_victory_inventory_header">सत्यापित इन्वेंट्री</string>
    <string name="onboarding_victory_inventory_sub">सभी 4 तैयार</string>
