    <string name="onboarding_items_title">आपको क्या ले जाने की आवश्यकता है?</string>
    <string name="onboarding_items_subtitle">%1$s के लिए निकलते समय जिन चीज़ों को आप भूलना नहीं चाहते, उन्हें जोड़ें।</string>
    <string name="onboarding_items_input_placeholder">एक आइटम जोड़ें</string>

    <!-- Screen 4: Configure Timing -->
    <string name="onboarding_timing_title">हमें आपको कब याद दिलाना चाहिए?</string>
    <string name="onboarding_timing_departure_label">प्रस्थान का समय</string>
    <string name="onboarding_timing_local_time">स्थानीय समय</string>
    <string name="onboarding_timing_notification_label">नोटिफिकेशन का समय</string>
    <string name="onboarding_timing_now_title">अभी</string>
