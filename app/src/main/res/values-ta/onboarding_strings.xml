    <!-- Screen 1: Welcome -->
    <string name="onboarding_welcome_title">கிளம்பும் முன் எதையும் மறக்காதீர்கள்.</string>
    <string name="onboarding_welcome_subtitle">நீங்கள் செல்லும் இடத்திற்கான சரிபார்ப்பு பட்டியலை உருவாக்கி, கிளம்புவதற்கு முன் நினைவூட்டல் பெறுங்கள்.</string>
    <string name="onboarding_welcome_get_started">தொடங்குங்கள்</string>
    <string name="onboarding_welcome_skip">தவிர்க்கவும்</string>

